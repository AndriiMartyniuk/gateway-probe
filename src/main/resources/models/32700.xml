<?xml version="1.0" encoding="UTF-8"?>
<!--
  Probe Sensor: private, unregistered research object of gateway-probe (Source = 2, private or individual).
  Object ID 32700 lies in the OMNA x-label range 26241-32768 and was not registered in the OMNA lwm2m-registry
  when chosen (2026-11). Not for production use.

  Each instance is one observable data stream. Every sample carries a sequence number and the device-side sample
  time, so the server can detect lost/duplicated notifications and compute the age of the data it receives.
-->
<LWM2M xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://www.openmobilealliance.org/tech/profiles/LWM2M-v1_1.xsd">
	<Object ObjectType="MODefinition">
		<Name>Probe Sensor</Name>
		<Description1><![CDATA[Synthetic data stream used to measure observation recovery and notification delivery. Each instance produces samples with a sequence number, a sample time, a value and an optional opaque payload.]]></Description1>
		<ObjectID>32700</ObjectID>
		<ObjectURN>urn:oma:lwm2m:x:32700</ObjectURN>
		<LWM2MVersion>1.1</LWM2MVersion>
		<ObjectVersion>1.0</ObjectVersion>
		<MultipleInstances>Multiple</MultipleInstances>
		<Mandatory>Optional</Mandatory>
		<Resources>
			<Item ID="0">
				<Name>Sequence Number</Name>
				<Operations>R</Operations>
				<MultipleInstances>Single</MultipleInstances>
				<Mandatory>Mandatory</Mandatory>
				<Type>Integer</Type>
				<RangeEnumeration></RangeEnumeration>
				<Units></Units>
				<Description><![CDATA[Number of the current sample. Starts at 0 when the instance is created and increases by 1 per sample; gaps mean lost notifications, repeats mean duplicates.]]></Description>
			</Item>
			<Item ID="1">
				<Name>Sample Time</Name>
				<Operations>R</Operations>
				<MultipleInstances>Single</MultipleInstances>
				<Mandatory>Mandatory</Mandatory>
				<Type>Integer</Type>
				<RangeEnumeration></RangeEnumeration>
				<Units>ms</Units>
				<Description><![CDATA[Device time when the current sample was produced, in milliseconds since the Unix epoch. (The LwM2M Time type has a resolution of one second, too coarse for data-age measurement.)]]></Description>
			</Item>
			<Item ID="2">
				<Name>Value</Name>
				<Operations>R</Operations>
				<MultipleInstances>Single</MultipleInstances>
				<Mandatory>Mandatory</Mandatory>
				<Type>Float</Type>
				<RangeEnumeration></RangeEnumeration>
				<Units></Units>
				<Description><![CDATA[Measured (synthetic) value of the current sample.]]></Description>
			</Item>
			<Item ID="3">
				<Name>Payload</Name>
				<Operations>R</Operations>
				<MultipleInstances>Single</MultipleInstances>
				<Mandatory>Optional</Mandatory>
				<Type>Opaque</Type>
				<RangeEnumeration></RangeEnumeration>
				<Units></Units>
				<Description><![CDATA[Filler bytes of Payload Size length, to control the notification size.]]></Description>
			</Item>
			<Item ID="4">
				<Name>Sample Period</Name>
				<Operations>RW</Operations>
				<MultipleInstances>Single</MultipleInstances>
				<Mandatory>Optional</Mandatory>
				<Type>Integer</Type>
				<RangeEnumeration>0..86400000</RangeEnumeration>
				<Units>ms</Units>
				<Description><![CDATA[Time between samples. 0 stops sampling.]]></Description>
			</Item>
			<Item ID="5">
				<Name>Payload Size</Name>
				<Operations>RW</Operations>
				<MultipleInstances>Single</MultipleInstances>
				<Mandatory>Optional</Mandatory>
				<Type>Integer</Type>
				<RangeEnumeration>0..65535</RangeEnumeration>
				<Units>B</Units>
				<Description><![CDATA[Size of the Payload resource in bytes.]]></Description>
			</Item>
		</Resources>
		<Description2></Description2>
	</Object>
</LWM2M>
